{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dfretailcropdata"
		},
		"ls_retailblob_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_retailblob'"
		},
		"ls_retailsql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_retailsql'"
		},
		"ls_retailsql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sr-sql-reatailcrop.database.windows.net"
		},
		"ls_retailsql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-retailcrop"
		},
		"ls_retailsql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Sadmin"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_retailblob')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "this is basically link for blob storage ",
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('ls_retailblob_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_retailsql')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "this is basically link of SQL",
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_retailsql_properties_typeProperties_server')]",
					"database": "[parameters('ls_retailsql_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_retailsql_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_retailsql_password')]"
					}
				}
			},
			"dependsOn": []
		},

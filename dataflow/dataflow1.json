{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_blob_customer_csv",
						"type": "DatasetReference"
					},
					"name": "customers1",
					"description": "this is about the customer dataset"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "filter1",
					"description": "filtering the  changes "
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          phone as string,",
				"          city as string,",
				"          state as string,",
				"          pincode as string,",
				"          tier as string,",
				"          segment as string,",
				"          registration_date as string,",
				"          is_active as integer,",
				"          credit_limit as string,",
				"          loyalty_points as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> customers1",
				"customers1 filter(is_active == 1) ~> filter1",
				"filter1 derive(customer_status = ERROR_FUNCTION('')) ~> derivedColumn1"
			]
		}
	}
}